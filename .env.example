# Copy this file to .env and fill it in. Keep .env private.

# --- Wyze ---
# Create an API key at https://developer-api-console.wyze.com/#/apikey/view
WYZE_EMAIL=you@example.com
WYZE_PASSWORD=
WYZE_KEY_ID=
WYZE_API_KEY=
# Only if your Wyze account has 2FA via an authenticator app: the setup secret (not a 6-digit code)
WYZE_TOTP_KEY=

# Optional: pick a scale if you have more than one (see `python sync.py --list-scales`)
# WYZE_SCALE_MODEL=WL_SC2
# Optional: sync another family member's weigh-ins instead of yours
# WYZE_FAMILY_MEMBER_ID=

# --- Garmin ---
# Run `python sync.py --login` once. Tokens are saved and refreshed automatically.
# Credentials here are only a fallback if the saved tokens stop working
# (that fallback can't answer an MFA prompt).
GARMIN_EMAIL=
GARMIN_PASSWORD=
# GARMIN_TOKEN_DIR=~/.garminconnect

# --- Behaviour ---
# Days to look back on the very first run
INITIAL_BACKFILL_DAYS=7
# Which Wyze field becomes Garmin "skeletal muscle mass": muscle or skeletal_muscle
MUSCLE_FIELD=muscle
# STATE_FILE=./state.json
